{
  "name": "raceiq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "node scripts/check-i18n.mjs && vite build",
    "build:demo": "node scripts/check-i18n.mjs && vite build --mode demo",
    "preview": "vite preview",
    "smoke": "node --env-file=.env.local scripts/smoke-claude.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "record:demo": "node --env-file=.env.local scripts/record-demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@supabase/supabase-js": "^2.111.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^26.1.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
