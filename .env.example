# ---------------------------------------------------------------------------
# Client-side (VITE_ prefixed vars are inlined into the browser bundle).
# The Supabase anon key is public by design — Row-Level Security protects data.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---------------------------------------------------------------------------
# Server-side only. NO VITE_ PREFIX — Vite withholds unprefixed vars from the
# client bundle, which is exactly why the Anthropic key is named this way.
# NEVER add VITE_ to this one.
#
# In production set it in the Vercel project's Environment Variables. Locally
# it lives in .env.local (gitignored), loaded by the dev middleware in
# vite.config.js.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Optional. /api/claude verifies Supabase tokens using VITE_SUPABASE_URL /
# VITE_SUPABASE_ANON_KEY above unless these are set. Only set them when the
# server should talk to a different Supabase project than the client.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Public demo (docs/deploy.md). Read by the browser bundle AND by /api/claude.
# With this on, the app never connects to Supabase and shows the sample athlete.
# For local preview use `npm run dev:demo` instead of setting it here.
# ---------------------------------------------------------------------------
# VITE_DEMO_MODE=true

# Server-side only. Live Claude calls a demo visitor may make. Both default to 0,
# which means the demo replays recorded answers and never spends a token.
# DEMO_AI_PER_CLIENT_PER_DAY=0
# DEMO_AI_GLOBAL_PER_DAY=0
